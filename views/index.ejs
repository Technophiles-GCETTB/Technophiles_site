<%- include('partials/head') %>
<%- include('partials/navbar') %>

<!-- AOS CSS -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<main class="pt-16">

  <!-- HERO SECTION -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Animated Grid Background -->
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(57,255,20,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(57,255,20,0.03) 1px, transparent 1px); background-size: 40px 40px; animation: gridMove 20s linear infinite;"></div>
    
    <!-- Floating Orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full orb-glow" style="background: radial-gradient(circle, rgba(57,255,20,0.08) 0%, transparent 70%); animation: floatOrb 6s ease-in-out infinite;"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 rounded-full orb-glow" style="background: radial-gradient(circle, rgba(57,255,20,0.05) 0%, transparent 70%); animation: floatOrb 8s ease-in-out infinite 2s;"></div>
    <div class="absolute top-1/2 right-1/6 w-48 h-48 rounded-full orb-glow hidden lg:block" style="background: radial-gradient(circle, rgba(57,255,20,0.06) 0%, transparent 70%); animation: floatOrb 7s ease-in-out infinite 1s;"></div>

    <div class="relative text-center px-4 max-w-5xl mx-auto">
      <!-- Badge -->
      <div class="inline-block border border-neon/30 px-4 py-1 mb-6 text-neon text-xs font-mono tracking-widest" data-aos="fade-down" data-aos-delay="100">
        <i data-lucide="hexagon" class="inline w-3 h-3 mr-1" style="vertical-align: middle;"></i> GCETTB OFFICIAL TECH CLUB <i data-lucide="hexagon" class="inline w-3 h-3 ml-1" style="vertical-align: middle;"></i>
      </div>
      
      <!-- Title -->
      <h1 class="font-display font-black text-white mb-6 leading-tight" style="font-size: clamp(2rem, 7vw, 6rem);" data-aos="zoom-in" data-aos-delay="200">
        TECHNO<span class="neon-text glitch-text">PHILES</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-gray-400 text-xl mb-10 max-w-2xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="300">
        Where code meets creativity. Join India's most active college tech community — learn, build, compete, and grow.
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 justify-center items-center" data-aos="fade-up" data-aos-delay="400">
        <% if (!currentUser) { %>
          <a href="/auth/register" class="btn-neon-solid text-base px-8 py-3 font-display tracking-widest group">
            JOIN NOW <i data-lucide="arrow-right" class="inline w-4 h-4 ml-1 transition-transform group-hover:translate-x-1"></i>
          </a>
          <a href="/events" class="btn-neon text-base px-8 py-3 font-display tracking-widest group">
            EXPLORE <i data-lucide="compass" class="inline w-4 h-4 ml-1 transition-transform group-hover:rotate-45"></i>
          </a>
        <% } else { %>
          <a href="/dashboard" class="btn-neon-solid text-base px-8 py-3 font-display tracking-widest group">
            DASHBOARD <i data-lucide="layout-dashboard" class="inline w-4 h-4 ml-1 transition-transform group-hover:scale-110"></i>
          </a>
          <a href="/hackathons" class="btn-neon text-base px-8 py-3 font-display tracking-widest group">
            HACKATHONS <i data-lucide="zap" class="inline w-4 h-4 ml-1 transition-transform group-hover:scale-125"></i>
          </a>
        <% } %>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 mt-10 sm:mt-20 max-w-3xl mx-auto">
        <% [['500+','Members','users'],['50+','Events','calendar'],['20+','Hackathons','trophy'],['100+','Courses','book-open']].forEach(([n,l,icon], i) => { %>
        <div class="card p-5 text-center stat-card" data-aos="fade-up" data-aos-delay="<%= 500 + (i * 100) %>">
          <i data-lucide="<%= icon %>" class="w-5 h-5 mx-auto mb-2 text-neon/60 stat-icon"></i>
          <p class="text-3xl font-display font-black neon-text"><%= n %></p>
          <p class="text-gray-500 text-xs mt-1 tracking-widest uppercase font-mono"><%= l %></p>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-gray-600 text-xs font-mono animate-bounce-slow">
      <span>SCROLL</span>
      <div class="w-px h-12 bg-gradient-to-b from-neon/50 to-transparent"></div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section class="py-20 px-4 max-w-7xl mx-auto" data-aos="fade-up">
    <div class="card p-8 md:p-12 relative overflow-hidden group">
      <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full opacity-20 group-hover:opacity-30 transition-opacity duration-700" style="background: radial-gradient(circle, rgba(57,255,20,0.15) 0%, transparent 70%);"></div>
      
      <div class="relative grid md:grid-cols-2 gap-10 items-center">
        <div>
          <p class="text-neon font-mono text-xs tracking-widest mb-2 flex items-center gap-2">
            <i data-lucide="info" class="w-4 h-4"></i> ◈ ABOUT US
          </p>
          <h2 class="font-display font-bold text-white text-3xl md:text-4xl mb-6">Building the Future,<br><span class="neon-text">One Line at a Time</span></h2>
          <p class="text-gray-400 leading-relaxed mb-4">
            Technophiles is the official tech club of Government College of Engineering and Textile Technology, Berhampore, formed to bring together passionate students interested in technology, innovation, and real-world problem solving. We are a community of developers, engineers, and creators who believe in learning beyond classrooms through practical implementation and collaboration.
          </p>
          <p class="text-gray-500 leading-relaxed mb-8">
            Our members come from diverse technical backgrounds, working together across software and core engineering domains to build projects, explore new technologies, and develop industry-ready skills. Technophiles serves as a platform where curiosity turns into creativity and ideas evolve into impactful solutions.
          </p>
          <a href="/about" class="btn-neon-solid text-sm px-6 py-2.5 font-display tracking-widest inline-flex items-center gap-2 group/btn">
            READ MORE <i data-lucide="arrow-right" class="w-4 h-4 transition-transform group-hover/btn:translate-x-1"></i>
          </a>
        </div>
        <div class="relative">
          <div class="grid grid-cols-2 gap-4">
            <div class="card p-4 text-center hover:border-neon/40 transition-all duration-300 hover:-translate-y-1" data-aos="zoom-in" data-aos-delay="100">
              <i data-lucide="code-2" class="w-8 h-8 mx-auto text-neon mb-2"></i>
              <p class="text-white font-semibold text-sm">Coding</p>
            </div>
            <div class="card p-4 text-center hover:border-neon/40 transition-all duration-300 hover:-translate-y-1 mt-6" data-aos="zoom-in" data-aos-delay="200">
              <i data-lucide="lightbulb" class="w-8 h-8 mx-auto text-neon mb-2"></i>
              <p class="text-white font-semibold text-sm">Innovation</p>
            </div>
            <div class="card p-4 text-center hover:border-neon/40 transition-all duration-300 hover:-translate-y-1" data-aos="zoom-in" data-aos-delay="300">
              <i data-lucide="users" class="w-8 h-8 mx-auto text-neon mb-2"></i>
              <p class="text-white font-semibold text-sm">Community</p>
            </div>
            <div class="card p-4 text-center hover:border-neon/40 transition-all duration-300 hover:-translate-y-1 mt-6" data-aos="zoom-in" data-aos-delay="400">
              <i data-lucide="rocket" class="w-8 h-8 mx-auto text-neon mb-2"></i>
              <p class="text-white font-semibold text-sm">Growth</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UPCOMING EVENTS -->
  <% if (upcomingEvents.length > 0) { %>
  <section class="py-20 px-4 max-w-7xl mx-auto">
    <div class="flex items-center justify-between mb-10" data-aos="fade-right">
      <div>
        <p class="text-neon font-mono text-xs tracking-widest mb-2 flex items-center gap-2">
          <i data-lucide="sparkles" class="w-3 h-3"></i> ◈ UPCOMING
        </p>
        <h2 class="font-display font-bold text-white text-3xl">EVENTS</h2>
      </div>
      <a href="/events" class="btn-neon text-sm group">
        VIEW ALL <i data-lucide="arrow-right" class="inline w-3 h-3 ml-1 transition-transform group-hover:translate-x-1"></i>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <% upcomingEvents.forEach((event, i) => { %>
      <a href="/events/<%= event._id %>" class="card p-5 block group event-card" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
        <div class="flex items-start justify-between mb-3">
          <span class="badge badge-neon text-xs flex items-center gap-1">
            <i data-lucide="tag" class="w-3 h-3"></i> <%= event.type %>
          </span>
          <span class="text-xs text-gray-500 font-mono flex items-center gap-1">
            <i data-lucide="calendar" class="w-3 h-3"></i> <%= new Date(event.startDate).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %>
          </span>
        </div>
        <h3 class="text-white font-semibold text-lg mb-2 group-hover:text-neon transition-colors"><%= event.title %></h3>
        <p class="text-gray-500 text-sm mb-4 line-clamp-2"><%= event.description.substring(0,100) %>...</p>
        <div class="flex items-center justify-between text-xs text-gray-600">
          <span class="flex items-center gap-1"><i data-lucide="users" class="w-3 h-3"></i> <%= event.participants.length %>/<%= event.maxParticipants %></span>
          <span class="text-neon font-mono flex items-center gap-1"><i data-lucide="star" class="w-3 h-3"></i> +<%= event.pointsReward %> pts</span>
        </div>
      </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- HACKATHONS -->
  <% if (hackathons.length > 0) { %>
  <section class="py-20 px-4 bg-dark-card">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-10" data-aos="fade-right">
        <div>
          <p class="text-neon font-mono text-xs tracking-widest mb-2 flex items-center gap-2">
            <i data-lucide="zap" class="w-3 h-3"></i> ◈ BUILD & WIN
          </p>
          <h2 class="font-display font-bold text-white text-3xl">HACKATHONS</h2>
        </div>
        <a href="/hackathons" class="btn-neon text-sm group">
          VIEW ALL <i data-lucide="arrow-right" class="inline w-3 h-3 ml-1 transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% hackathons.forEach((h, i) => { %>
        <a href="/hackathons/<%= h._id %>" class="card p-6 block group hackathon-card" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-10 h-10 bg-neon/10 border border-neon/30 rounded flex items-center justify-center icon-box">
              <i data-lucide="zap" class="text-neon text-lg"></i>
            </div>
            <span class="badge badge-neon text-xs"><%= h.status.replace('_',' ') %></span>
          </div>
          <h3 class="text-white font-bold text-lg mb-2 group-hover:text-neon transition-colors"><%= h.title %></h3>
          <% if (h.tagline) { %><p class="text-gray-500 text-sm mb-4 line-clamp-2"><%= h.tagline %></p><% } %>
          <div class="flex justify-between text-xs text-gray-600 font-mono pt-3 border-t border-dark-border">
            <span class="flex items-center gap-1"><i data-lucide="calendar-days" class="w-3 h-3"></i> <%= new Date(h.hackathonStart).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %></span>
            <span class="text-neon flex items-center gap-1"><i data-lucide="star" class="w-3 h-3"></i> +<%= h.pointsReward %> pts</span>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- FEATURED PROJECTS -->
  <% if (typeof featuredProjects !== 'undefined' && featuredProjects.length > 0) { %>
  <section class="py-20 px-4 bg-dark-card">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-10" data-aos="fade-right">
        <div>
          <p class="text-neon font-mono text-xs tracking-widest mb-2 flex items-center gap-2">
            <i data-lucide="folder-git-2" class="w-3 h-3"></i> ◈ COMMUNITY WORK
          </p>
          <h2 class="font-display font-bold text-white text-3xl">FEATURED PROJECTS</h2>
        </div>
        <a href="/projects" class="btn-neon text-sm group">
          VIEW ALL <i data-lucide="arrow-right" class="inline w-3 h-3 ml-1 transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% featuredProjects.forEach((p, i) => { %>
        <a href="/projects/<%= p._id %>" class="card group block overflow-hidden project-card" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
          <div class="w-full h-36 overflow-hidden bg-dark-hover flex items-center justify-center relative">
            <% if (p.thumbnail && !p.thumbnail.includes('project-default')) { %>
            <img src="<%= p.thumbnail %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'">
            <div class="absolute inset-0 flex items-center justify-center text-4xl hidden">
              <i data-lucide="<%= p.category==='web'?'globe':p.category==='mobile'?'smartphone':p.category==='ai_ml'?'brain':'lightbulb' %>" class="w-12 h-12 text-neon/40"></i>
            </div>
            <% } else { %>
            <div class="flex items-center justify-center text-4xl">
              <i data-lucide="<%= p.category==='web'?'globe':p.category==='mobile'?'smartphone':p.category==='ai_ml'?'brain':'lightbulb' %>" class="w-12 h-12 text-neon/40"></i>
            </div>
            <% } %>
          </div>
          <div class="p-4">
            <h3 class="text-white font-bold group-hover:text-neon transition-colors"><%= p.title %></h3>
            <p class="text-gray-500 text-sm mt-1 line-clamp-2"><%= p.description %></p>
            <div class="flex items-center justify-between mt-3 text-xs text-gray-600 font-mono">
              <span><%= p.techStack?.slice(0,2).join(' · ') %></span>
              <span class="flex items-center gap-1"><i data-lucide="heart" class="w-3 h-3 text-neon/60"></i> <%= p.likes %></span>
            </div>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- QUICK LINKS BAND -->
  <section class="py-10 px-4 border-y border-dark-border">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap justify-center gap-4">
        <% [['calendar','Events','/events'],['zap','Hackathons','/hackathons'],['radio','Live Classes','/live-classes'],['book-open','Courses','/courses'],['map','Roadmaps','/roadmaps'],['calendar-days','Calendar','/calendar'],['folder-git-2','Projects','/projects'],['users','Team','/members']].forEach(([icon,label,href], i) => { %>
        <a href="<%= href %>" class="flex items-center gap-2 px-4 py-2 card hover:border-neon/30 text-sm text-gray-400 hover:text-neon transition-all duration-300 hover:-translate-y-0.5 quick-link" data-aos="zoom-in" data-aos-delay="<%= i * 50 %>">
          <i data-lucide="<%= icon %>" class="w-4 h-4"></i><span class="font-semibold"><%= label %></span>
        </a>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- PLATFORM FEATURES -->
  <section class="py-20 px-4 max-w-7xl mx-auto">
    <div class="text-center mb-12" data-aos="fade-down">
      <p class="text-neon font-mono text-xs tracking-widest mb-2 flex items-center justify-center gap-2">
        <i data-lucide="layers" class="w-3 h-3"></i> ◈ WHAT WE OFFER
      </p>
      <h2 class="font-display font-bold text-white text-3xl">PLATFORM FEATURES</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <% [
        ['book-open','LMS & Courses','/courses','Self-paced learning with modules, video content, and progress tracking'],
        ['trophy','Hackathons','/hackathons','Team registration, submissions, judge scoring, and leaderboards'],
        ['brain','Quiz System','/quiz','MCQ quizzes with timers, auto-evaluation and scoreboards'],
        ['scan-line','QR Attendance','/attendance/my','Scan QR to mark attendance and earn points automatically'],
        ['bar-chart-3','Leaderboard','/leaderboard','Points system with badges and rankings across all activities'],
        ['map','Roadmaps','/roadmaps','Structured learning paths for Web Dev, DSA, AI/ML and more']
      ].forEach(([icon, title, href, desc], i) => { %>
      <a href="<%= href %>" class="card p-6 group feature-card block" data-aos="fade-up" data-aos-delay="<%= i * 100 %>">
        <div class="w-12 h-12 rounded-lg bg-neon/5 border border-neon/20 flex items-center justify-center mb-4 group-hover:bg-neon/10 group-hover:border-neon/40 transition-all duration-300 feature-icon-box">
          <i data-lucide="<%= icon %>" class="w-6 h-6 text-neon feature-icon transition-transform duration-300"></i>
        </div>
        <h3 class="text-white font-bold text-lg mb-2 group-hover:text-neon transition-colors font-display flex items-center gap-2">
          <%= title %> <i data-lucide="arrow-up-right" class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"></i>
        </h3>
        <p class="text-gray-500 text-sm leading-relaxed"><%= desc %></p>
      </a>
      <% }) %>
    </div>
  </section>

  <!-- ECOSYSTEM FLYWHEEL -->
     <!-- ECOSYSTEM FLYWHEEL -->
  <section class="py-20 px-4 bg-dark-card relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12" data-aos="fade-down">
        <p class="text-neon font-mono text-xs tracking-widest mb-2 flex items-center justify-center gap-2">
          <i data-lucide="refresh-cw" class="w-3 h-3"></i> ◈ HOW IT WORKS
        </p>
        <h2 class="font-display font-bold text-white text-3xl">THE ECOSYSTEM <span class="neon-text">FLYWHEEL</span></h2>
        <p class="text-gray-500 mt-3 max-w-xl mx-auto">A self-reinforcing cycle where every activity fuels growth for the entire community.</p>
      </div>

      <!-- 
        MOBILE VIEW: Vertical Flow (visible below md breakpoint)
        Clean stacked cards with animated connecting lines
      -->
      <div class="md:hidden flex flex-col items-center gap-0 max-w-sm mx-auto">
        <!-- Node 1 -->
        <div class="w-full" data-aos="fade-up" data-aos-delay="0">
          <div class="card p-4 flex items-center gap-4 border-neon/10 hover:border-neon/40 transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-neon/10 border border-neon/20 flex items-center justify-center flex-shrink-0">
              <i data-lucide="graduation-cap" class="w-5 h-5 text-neon"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white font-bold text-sm">LEARN</p>
              <p class="text-gray-500 text-xs">Courses & Roadmaps</p>
            </div>
            <div class="flex flex-col items-center gap-0.5">
              <i data-lucide="arrow-down" class="w-4 h-4 text-neon/40 animate-bounce"></i>
            </div>
          </div>
        </div>

        <!-- Connector -->
        <div class="flex flex-col items-center py-1">
          <div class="w-0.5 h-4 bg-gradient-to-b from-neon/30 to-neon/60"></div>
          <div class="w-2 h-2 rounded-full bg-neon/50 animate-pulse"></div>
          <div class="w-0.5 h-4 bg-gradient-to-b from-neon/60 to-neon/30"></div>
        </div>

        <!-- Node 2 -->
        <div class="w-full" data-aos="fade-up" data-aos-delay="80">
          <div class="card p-4 flex items-center gap-4 border-neon/10 hover:border-neon/40 transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-neon/10 border border-neon/20 flex items-center justify-center flex-shrink-0">
              <i data-lucide="hammer" class="w-5 h-5 text-neon"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white font-bold text-sm">BUILD</p>
              <p class="text-gray-500 text-xs">Projects & Hackathons</p>
            </div>
            <i data-lucide="arrow-down" class="w-4 h-4 text-neon/40 animate-bounce"></i>
          </div>
        </div>

        <!-- Connector -->
        <div class="flex flex-col items-center py-1">
          <div class="w-0.5 h-4 bg-gradient-to-b from-neon/30 to-neon/60"></div>
          <div class="w-2 h-2 rounded-full bg-neon/50 animate-pulse"></div>
          <div class="w-0.5 h-4 bg-gradient-to-b from-neon/60 to-neon/30"></div>
        </div>

        <!-- Node 3 -->
        <div class="w-full" data-aos="fade-up" data-aos-delay="160">
          <div class="card p-4 flex items-center gap-4 border-neon/10 hover:border-neon/40 transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-neon/10 border border-neon/20 flex items-center justify-center flex-shrink-0">
              <i data-lucide="swords" class="w-5 h-5 text-neon"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white font-bold text-sm">COMPETE</p>
              <p class="text-gray-500 text-xs">Quizzes & Contests</p>
            </div>
            <i data-lucide="arrow-down" class="w-4 h-4 text-neon/40 animate-bounce"></i>
          </div>
        </div>

        <!-- Connector -->
        <div class="flex flex-col items-center py-1">
          <div class="w-0.5 h-4 bg-gradient-to-b from-neon/30 to-neon/60"></div>
          <div class="w-2 h-2 rounded-full bg-neon/50 animate-pulse"></div>
          <div class="w-0.5 h-4 bg-gradient-to-b from-neon/60 to-neon/30"></div>
        </div>

        <!-- Node 4 -->
        <div class="w-full" data-aos="fade-up" data-aos-delay="240">
          <div class="card p-4 flex items-center gap-4 border-neon/10 hover:border-neon/40 transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-neon/10 border border-neon/20 flex items-center justify-center flex-shrink-0">
              <i data-lucide="trophy" class="w-5 h-5 text-neon"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white font-bold text-sm">EARN</p>
              <p class="text-gray-500 text-xs">Points & Badges</p>
            </div>
