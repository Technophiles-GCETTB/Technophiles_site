<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>

<script>
  // Initialize AOS
  AOS.init({
    duration: 600,
    easing: 'ease-out-cubic',
    once: true,
    offset: 50,
    delay: 0,
  });

  // Initialize Lucide Icons
  lucide.createIcons();

  // Re-create icons after any dynamic content updates
  document.addEventListener('DOMContentLoaded', function() {
    lucide.createIcons();
  });
</script>

<style>
  /* ===== CUSTOM ANIMATIONS ===== */
  
  @keyframes gridMove {
    0% { background-position: 0 0; }
    100% { background-position: 40px 40px; }
  }

  @keyframes floatOrb {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
  }

  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @keyframes glitch {
    0% { text-shadow: 2px 0 #39ff14, -2px 0 #ff00ff; }
    25% { text-shadow: -2px 0 #39ff14, 2px 0 #00ffff; }
    50% { text-shadow: 2px 0 #ff00ff, -2px 0 #39ff14; }
    75% { text-shadow: -2px 0 #00ffff, 2px 0 #ff00ff; }
    100% { text-shadow: 2px 0 #39ff14, -2px 0 #ff00ff; }
  }

  /* Flywheel Animations */
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes spin-reverse {
    from { transform: rotate(360deg); }
    to { transform: rotate(0deg); }
  }

  @keyframes orbit {
    from { transform: rotate(0deg) translateX(180px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(180px) rotate(-360deg); }
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(57,255,20,0.2); }
    50% { box-shadow: 0 0 40px rgba(57,255,20,0.4), 0 0 60px rgba(57,255,20,0.1); }
  }

  @keyframes float-node {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }

  .glitch-text {
    position: relative;
  }
  .glitch-text:hover {
    animation: glitch 0.3s ease-in-out;
  }

  .orb-glow {
    pointer-events: none;
  }

  .animate-pulse-glow {
    animation: pulse-glow 2s ease-in-out infinite;
  }

  /* Flywheel Styles */
  .flywheel-ring {
    animation: spin-slow 60s linear infinite;
  }

  .flywheel-gear {
    animation: spin-reverse 30s linear infinite;
  }

  .orbit-dot {
    transform-origin: center;
  }

  .orbit-1 { animation: orbit 8s linear infinite; }
  .orbit-2 { animation: orbit 8s linear infinite 2s; }
  .orbit-3 { animation: orbit 8s linear infinite 4s; }
  .orbit-4 { animation: orbit 8s linear infinite 6s; }

  .flywheel-node {
    position: absolute;
    transition: all 0.3s ease;
  }

  .flywheel-node:hover {
    transform: scale(1.08) !important;
    z-index: 20;
  }

  /* Position nodes in a circle */
  .node-1 { top: 0; left: 50%; transform: translateX(-50%); animation: float-node 4s ease-in-out infinite; }
  .node-2 { top: 25%; right: 0; transform: translateX(30%); animation: float-node 4s ease-in-out infinite 0.5s; }
  .node-3 { bottom: 25%; right: 0; transform: translateX(30%); animation: float-node 4s ease-in-out infinite 1s; }
  .node-4 { bottom: 0; left: 50%; transform: translateX(-50%); animation: float-node 4s ease-in-out infinite 1.5s; }
  .node-5 { bottom: 25%; left: 0; transform: translateX(-30%); animation: float-node 4s ease-in-out infinite 2s; }
  .node-6 { top: 25%; left: 0; transform: translateX(-30%); animation: float-node 4s ease-in-out infinite 2.5s; }

  /* Stat Card Hover */
  .stat-card {
    transition: all 0.3s ease;
  }
  .stat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(57, 255, 20, 0.3);
    box-shadow: 0 10px 30px -10px rgba(57, 255, 20, 0.1);
  }
  .stat-card:hover .stat-icon {
    transform: scale(1.2);
  }
  .stat-icon {
    transition: transform 0.3s ease;
  }

  /* Event Card Hover */
  .event-card {
    transition: all 0.3s ease;
  }
  .event-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(57, 255, 20, 0.08);
  }

  /* Hackathon Card Hover */
  .hackathon-card {
    transition: all 0.3s ease;
  }
  .hackathon-card:hover {
    transform: translateY(-4px);
  }
  .hackathon-card:hover .icon-box {
    background: rgba(57, 255, 20, 0.15);
    transform: rotate(5deg) scale(1.1);
  }
  .icon-box {
    transition: all 0.3s ease;
  }

  /* Project Card Hover */
  .project-card {
    transition: all 0.3s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(57, 255, 20, 0.08);
  }

  /* Quick Link Hover */
  .quick-link {
    transition: all 0.3s ease;
  }
  .quick-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px -10px rgba(57, 255, 20, 0.1);
  }

  /* Feature Card Hover */
  .feature-card {
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 50px -15px rgba(57, 255, 20, 0.1);
    border-color: rgba(57, 255, 20, 0.3);
  }
  .feature-card:hover .feature-icon {
    transform: scale(1.15) rotate(-5deg);
  }
  .feature-icon-box {
    transition: all 0.3s ease;
  }
  .feature-card:hover .feature-icon-box {
    background: rgba(57, 255, 20, 0.1);
  }

  /* Connect Card Hover */
  .connect-card {
    transition: all 0.3s ease;
  }
  .connect-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 50px -15px rgba(57, 255, 20, 0.08);
    border-color: rgba(57, 255, 20, 0.3);
  }

